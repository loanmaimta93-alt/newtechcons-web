# Cache-Control cho Cloudflare Pages — tăng tốc tải trang cho khách quay lại.
# Astro thêm hash vào tên file JS/CSS trong /_astro/, nên có thể cache dài hạn an toàn.

# Security headers áp dụng cho toàn bộ trang — chống clickjacking, MIME sniffing,
# rò rỉ referrer sang bên thứ ba, và giới hạn nguồn script/frame được phép chạy.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; frame-src https://www.google.com; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/*.xml
  Cache-Control: public, max-age=3600

/admin/*
  X-Robots-Tag: noindex
  # CSP riêng cho Decap CMS — trang này cần tải script từ identity.netlify.com
  # (đăng nhập) và unpkg.com (chính engine CMS), và gọi API tới *.netlify.app
  # (Git Gateway). Nới lỏng hơn trang chính, nhưng vẫn chỉ áp dụng cho /admin.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://identity.netlify.com https://unpkg.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self' data:; img-src 'self' data: https: blob:; connect-src 'self' https://*.netlify.com https://*.netlify.app https://api.github.com wss://*.netlify.app; frame-src https://www.netlify.com; worker-src 'self' blob:
