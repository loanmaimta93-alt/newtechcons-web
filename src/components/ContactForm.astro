---
// Form liên hệ dùng Web3Forms (https://web3forms.com) — không cần backend riêng.
//
// THAY: tạo access key miễn phí tại https://web3forms.com, sau đó:
//  1) Tạo file `.env` ở gốc dự án (copy từ `.env.example`)
//  2) Dán key vào biến PUBLIC_WEB3FORMS_KEY
//  3) Khi deploy lên Cloudflare Pages, khai báo biến môi trường PUBLIC_WEB3FORMS_KEY
//     trong Settings → Environment variables của dự án Pages.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
const chuaCauHinh = !accessKey;
---

<div class="border border-navy-100 bg-white p-6 shadow-card sm:p-8">
  {
    chuaCauHinh && (
      <p class="mb-5 border-l-4 border-brand-red bg-brand-red/5 px-4 py-3 text-sm text-brand-red-dark">
        ⚠️ Form chưa có <code>PUBLIC_WEB3FORMS_KEY</code>. Xem hướng dẫn trong file <code>.env.example</code> hoặc
        <code> HUONG-DAN.md</code> để kích hoạt gửi form thật.
      </p>
    )
  }

  <form
    id="form-lien-he"
    action="https://api.web3forms.com/submit"
    method="POST"
    class="grid grid-cols-1 gap-5 sm:grid-cols-2"
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Yêu cầu tư vấn từ website Newtechcons" />
    <input type="hidden" name="from_name" value="Website Newtechcons" />
    <input type="hidden" name="redirect" value="/lien-he/cam-on" />
    {/* Honeypot chống spam — để trống, bot sẽ tự điền */}
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

    <div class="sm:col-span-1">
      <label for="ho-ten" class="mb-1.5 block text-sm font-semibold text-navy-deep">Họ và tên *</label>
      <input
        id="ho-ten"
        name="name"
        type="text"
        required
        class="w-full rounded-sm border border-navy-100 px-3.5 py-2.5 text-sm text-ink outline-none focus-visible:border-brand-red"
        placeholder="Nguyễn Văn A"
      />
    </div>

    <div class="sm:col-span-1">
      <label for="dien-thoai" class="mb-1.5 block text-sm font-semibold text-navy-deep">Số điện thoại *</label>
      <input
        id="dien-thoai"
        name="phone"
        type="tel"
        required
        class="w-full rounded-sm border border-navy-100 px-3.5 py-2.5 text-sm text-ink outline-none focus-visible:border-brand-red"
        placeholder="09xx xxx xxx"
      />
    </div>

    <div class="sm:col-span-2">
      <label for="email" class="mb-1.5 block text-sm font-semibold text-navy-deep">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        class="w-full rounded-sm border border-navy-100 px-3.5 py-2.5 text-sm text-ink outline-none focus-visible:border-brand-red"
        placeholder="ban@congty.com"
      />
    </div>

    <div class="sm:col-span-2">
      <label for="cong-ty" class="mb-1.5 block text-sm font-semibold text-navy-deep">Đơn vị / dự án</label>
      <input
        id="cong-ty"
        name="company"
        type="text"
        class="w-full rounded-sm border border-navy-100 px-3.5 py-2.5 text-sm text-ink outline-none focus-visible:border-brand-red"
        placeholder="Tên công ty / tên dự án"
      />
    </div>

    <div class="sm:col-span-2">
      <label for="noi-dung" class="mb-1.5 block text-sm font-semibold text-navy-deep">Nội dung cần tư vấn *</label>
      <textarea
        id="noi-dung"
        name="message"
        required
        rows="5"
        class="w-full rounded-sm border border-navy-100 px-3.5 py-2.5 text-sm text-ink outline-none focus-visible:border-brand-red"
        placeholder="Mô tả ngắn về công trình: loại nước thải, công suất dự kiến, địa điểm..."
      ></textarea>
    </div>

    <div class="sm:col-span-2">
      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-sm bg-brand-red px-7 py-3 font-display text-sm font-bold uppercase tracking-wide text-white transition-colors hover:bg-brand-red-dark disabled:cursor-not-allowed disabled:opacity-60"
      >
        Gửi yêu cầu tư vấn
      </button>
      <p id="thong-bao-form" class="mt-3 text-sm" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>

<script>
  // Nâng cấp tiệm tiến: gửi form bằng fetch để không rời trang; nếu JS tắt,
  // form vẫn hoạt động bình thường qua action/redirect ở trên.
  const form = document.getElementById('form-lien-he') as HTMLFormElement | null;
  const thongBao = document.getElementById('thong-bao-form');

  form?.addEventListener('submit', async (su) => {
    su.preventDefault();
    const nutGui = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (nutGui) {
      nutGui.disabled = true;
      nutGui.textContent = 'Đang gửi...';
    }
    if (thongBao) {
      thongBao.textContent = '';
      thongBao.className = 'mt-3 text-sm';
    }

    try {
      const duLieu = new FormData(form);
      const ketQua = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: duLieu,
      }).then((r) => r.json());

      if (ketQua.success) {
        form.reset();
        if (thongBao) {
          thongBao.textContent = '✅ Đã gửi thành công! Đội ngũ Newtechcons sẽ liên hệ lại sớm nhất.';
          thongBao.className = 'mt-3 text-sm font-semibold text-navy';
        }
      } else {
        throw new Error(ketQua.message || 'Gửi thất bại');
      }
    } catch (err) {
      // THAY: đang hiện chi tiết lỗi thật để debug — sau khi form chạy ổn thì đổi lại
      // thành thông báo chung chung như cũ cho gọn gàng với người dùng cuối.
      console.error('Lỗi gửi form liên hệ:', err);
      if (thongBao) {
        const chiTiet = err instanceof Error ? err.message : String(err);
        thongBao.textContent = `❌ Có lỗi khi gửi (chi tiết: ${chiTiet}). Vui lòng gọi hotline hoặc thử lại sau.`;
        thongBao.className = 'mt-3 text-sm font-semibold text-brand-red';
      }
    } finally {
      if (nutGui) {
        nutGui.disabled = false;
        nutGui.textContent = 'Gửi yêu cầu tư vấn';
      }
    }
  });
</script>
