---
import { congTy } from '@/data/congTy';
import Container from '@/components/Container.astro';

const duongDan = [
  { href: '/', nhan: 'Trang chủ' },
  { href: '/gioi-thieu', nhan: 'Giới thiệu' },
  { href: '/dich-vu', nhan: 'Dịch vụ' },
  { href: '/du-an', nhan: 'Dự án' },
  { href: '/tin-tuc', nhan: 'Tin tức' },
  { href: '/lien-he', nhan: 'Liên hệ' },
];

const duongDanHienTai = Astro.url.pathname;
function dangHoatDong(href: string) {
  if (href === '/') return duongDanHienTai === '/';
  return duongDanHienTai.startsWith(href);
}
---

<header class="sticky top-0 z-50">
  <!-- Dải số liệu mỏng — như thanh trạng thái thiết bị -->
  <div class="hidden bg-navy-deep text-navy-100 md:block">
    <Container class="flex items-center justify-between py-1.5 text-xs">
      <p class="tracking-wide">{congTy.phuongCham}</p>
      <div class="flex items-center gap-5">
        {
          congTy.thongKe.map((tk) => (
            <span class="tracking-wide">
              <strong class="font-display font-bold text-white">{tk.so}</strong> {tk.nhan}
            </span>
          ))
        }
      </div>
    </Container>
  </div>

  <!-- Nav chính -->
  <div class="border-b border-navy-100 bg-white/95 backdrop-blur">
    <Container class="flex items-center justify-between py-3">
      <a href="/" class="flex items-center gap-3">
        <img
          src="/images/thuong-hieu/newtechcons-mark.png"
          alt={`Logo ${congTy.tenNgan}`}
          width="40"
          height="40"
          class="h-9 w-auto"
        />
        <span class="font-display text-lg font-extrabold leading-none">
          <span class="text-navy">NEW</span><span class="text-brand-red">TECHCONS</span>
        </span>
      </a>

      <nav class="hidden items-center gap-7 lg:flex" aria-label="Menu chính">
        {
          duongDan.map((m) => (
            <a
              href={m.href}
              class:list={[
                'font-display text-sm font-bold uppercase tracking-wide transition-colors',
                dangHoatDong(m.href) ? 'text-brand-red' : 'text-navy-deep hover:text-brand-red',
              ]}
              aria-current={dangHoatDong(m.href) ? 'page' : undefined}
            >
              {m.nhan}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-3 lg:flex">
        <a
          href={congTy.hotlineHref}
          class="font-display text-sm font-bold text-navy-deep hover:text-brand-red"
        >
          📞 {congTy.hotline}
        </a>
        <a
          href="/lien-he"
          class="rounded-sm bg-brand-red px-5 py-2.5 font-display text-sm font-bold uppercase tracking-wide text-white transition-colors hover:bg-brand-red-dark"
        >
          Nhận tư vấn
        </a>
      </div>

      <!-- Menu di động: dùng details/summary để không cần JavaScript -->
      <details class="group relative lg:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-sm border border-navy-100 [&::-webkit-details-marker]:hidden"
          aria-label="Mở menu"
        >
          <span class="sr-only">Mở menu</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-navy-deep" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <nav
          class="fixed inset-x-0 top-[57px] z-40 max-h-[calc(100vh-57px)] overflow-y-auto border-t border-navy-100 bg-white px-4 py-4 shadow-card"
          aria-label="Menu chính (di động)"
        >
          <ul class="flex flex-col gap-1">
            {
              duongDan.map((m) => (
                <li>
                  <a
                    href={m.href}
                    class:list={[
                      'block rounded-sm px-3 py-3 font-display text-base font-bold uppercase tracking-wide',
                      dangHoatDong(m.href) ? 'bg-navy-50 text-brand-red' : 'text-navy-deep',
                    ]}
                  >
                    {m.nhan}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="mt-4 flex flex-col gap-2 border-t border-navy-100 pt-4">
            <a href={congTy.hotlineHref} class="font-display text-sm font-bold text-navy-deep">
              📞 Gọi ngay: {congTy.hotline}
            </a>
            <a
              href="/lien-he"
              class="rounded-sm bg-brand-red px-5 py-3 text-center font-display text-sm font-bold uppercase tracking-wide text-white"
            >
              Nhận tư vấn
            </a>
          </div>
        </nav>
      </details>
    </Container>
  </div>
</header>
