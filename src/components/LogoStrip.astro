---
import { khachHang } from '@/data/congTy';
---

<div class="border-y border-navy-100 bg-paper py-10">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="mb-6 text-center font-display text-sm font-bold uppercase tracking-widest text-ink/50">
      Được tin tưởng bởi các chủ đầu tư &amp; tổng thầu
    </p>
    <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6 sm:gap-x-14">
      {
        khachHang.map((kh) => (
          <li class="flex h-9 items-center opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0 sm:h-11">
            <img src={kh.logo} alt={kh.ten} class="h-full w-auto object-contain" loading="lazy" />
          </li>
        ))
      }
    </ul>
  </div>
</div>
