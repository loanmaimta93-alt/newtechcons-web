---
import DichVuIcon from '@/components/DichVuIcon.astro';

interface Props {
  href: string;
  icon: 'giot-nuoc' | 'bo-loc' | 'duong-ong' | 'dong-ho' | 'nha-may' | 'bao-tri' | 'ho-so';
  tieuDe: string;
  moTa: string;
}
const { href, icon, tieuDe, moTa } = Astro.props;
---

<a
  href={href}
  class="group relative flex flex-col gap-4 border border-navy-100 bg-white p-6 shadow-card transition-shadow hover:shadow-lg"
>
  <div class="flex h-14 w-14 items-center justify-center rounded-sm bg-navy text-white transition-colors group-hover:bg-brand-red">
    <DichVuIcon icon={icon} />
  </div>
  <h3 class="font-display text-lg font-bold text-navy-deep">{tieuDe}</h3>
  <p class="text-sm leading-relaxed text-ink/70">{moTa}</p>
  <span class="mt-auto inline-flex items-center gap-1.5 font-display text-sm font-bold uppercase tracking-wide text-brand-red">
    Xem chi tiết
    <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition-transform group-hover:translate-x-1">
      <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <span class="absolute right-0 top-0 h-8 w-8 goc-chevron-nguoc bg-navy-50 transition-colors group-hover:bg-brand-red/10" aria-hidden="true"></span>
</a>
