---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingContact from '@/components/FloatingContact.astro';

interface Props {
  tieuDe: string;
  moTa: string;
  anh?: string;
  loaiOg?: 'website' | 'article';
  khongIndex?: boolean;
}
const { tieuDe, moTa, anh, loaiOg, khongIndex } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <BaseHead tieuDe={tieuDe} moTa={moTa} anh={anh} loaiOg={loaiOg} khongIndex={khongIndex} />
  </head>
  <body>
    <a
      href="#noi-dung-chinh"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-sm focus:bg-brand-red focus:px-4 focus:py-2 focus:text-white"
    >
      Bỏ qua đến nội dung chính
    </a>
    <Header />
    <main id="noi-dung-chinh">
      <slot />
    </main>
    <Footer />
    <FloatingContact />
  </body>
</html>
