---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CTASection from '@/components/CTASection.astro';
import ProjectCard from '@/components/ProjectCard.astro';

export async function getStaticPaths() {
  const dsDuAn = await getCollection('du-an');
  return dsDuAn.map((da) => ({ params: { slug: da.id }, props: { da } }));
}

const { da } = Astro.props;
const { Content } = await render(da);

const tatCaDuAn = await getCollection('du-an');
const lienQuan = tatCaDuAn
  .filter((x) => x.id !== da.id && x.data.linhVuc === da.data.linhVuc)
  .sort((a, b) => a.data.thuTu - b.data.thuTu)
  .slice(0, 3);

const thongSo = [
  { nhan: 'Chủ đầu tư', gia: da.data.chuDauTu },
  { nhan: 'Địa điểm', gia: da.data.diaDiem },
  { nhan: 'Công suất', gia: da.data.congSuat },
  { nhan: 'Năm hoàn thành', gia: String(da.data.namHoanThanh) },
  { nhan: 'Lĩnh vực', gia: da.data.linhVuc },
];
---

<BaseLayout tieuDe={da.data.tieuDe} moTa={da.data.tomTat} anh={da.data.anhBia}>
  <Breadcrumb
    muc={[
      { nhan: 'Trang chủ', href: '/' },
      { nhan: 'Dự án', href: '/du-an' },
      { nhan: da.data.tieuDe },
    ]}
  />

  <section class="relative">
    <img src={da.data.anhBia} alt={da.data.anhBiaAlt} width="1600" height="900" class="aspect-[16/9] w-full object-cover sm:aspect-[21/9]" />
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-deep/90 to-transparent pb-8 pt-16">
      <Container>
        <span class="bg-brand-red px-3 py-1 font-display text-xs font-bold uppercase tracking-wide text-white">
          {da.data.linhVuc}
        </span>
        <h1 class="mt-3 max-w-3xl font-display text-2xl font-extrabold text-white sm:text-3xl">{da.data.tieuDe}</h1>
      </Container>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <Container class="grid gap-12 lg:grid-cols-[2fr_1fr]">
      <article class="prose-newtechcons max-w-none">
        <Content />

        {
          da.data.thuVienAnh.length > 0 && (
            <div class="not-prose mt-10 grid gap-4 sm:grid-cols-2">
              {da.data.thuVienAnh.map((anh) => (
                <img src={anh.duong_dan} alt={anh.alt} loading="lazy" width="800" height="600" class="aspect-[4/3] w-full object-cover" />
              ))}
            </div>
          )
        }
      </article>

      <aside class="space-y-6">
        <div class="border border-navy-100 bg-paper p-6">
          <h2 class="font-display text-sm font-bold uppercase tracking-widest text-navy-deep">Thông số dự án</h2>
          <dl class="mt-4 space-y-4">
            {
              thongSo.map((ts) => (
                <div class="flex justify-between gap-4 border-b border-navy-100/70 pb-3 text-sm last:border-0 last:pb-0">
                  <dt class="text-ink/55">{ts.nhan}</dt>
                  <dd class="text-right font-semibold text-navy-deep">{ts.gia}</dd>
                </div>
              ))
            }
          </dl>
          {
            da.data.congNghe.length > 0 && (
              <div class="mt-5 border-t border-navy-100 pt-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink/55">Công nghệ áp dụng</p>
                <ul class="mt-2.5 flex flex-wrap gap-2">
                  {da.data.congNghe.map((cn) => (
                    <li class="bg-navy px-2.5 py-1 text-xs font-medium text-white">{cn}</li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <a
          href="/lien-he"
          class="block bg-brand-red px-6 py-5 text-center font-display text-sm font-bold uppercase tracking-wide text-white hover:bg-brand-red-dark"
        >
          Tư vấn dự án tương tự
        </a>
      </aside>
    </Container>
  </section>

  {
    lienQuan.length > 0 && (
      <section class="bg-paper py-16 sm:py-20">
        <Container>
          <h2 class="font-display text-2xl font-extrabold text-navy-deep">Dự án cùng lĩnh vực</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {lienQuan.map((lq) => (
              <ProjectCard
                href={`/du-an/${lq.id}`}
                anh={lq.data.anhBia}
                anhAlt={lq.data.anhBiaAlt}
                linhVuc={lq.data.linhVuc}
                tieuDe={lq.data.tieuDe}
                diaDiem={lq.data.diaDiem}
                congSuat={lq.data.congSuat}
                namHoanThanh={lq.data.namHoanThanh}
              />
            ))}
          </div>
        </Container>
      </section>
    )
  }

  <CTASection />
</BaseLayout>
