---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CTASection from '@/components/CTASection.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { gioiThieu } from '@/data/congTy';

// Tô màu chữ Newtechcons trong tiêu đề giống logo, nếu tiêu đề có chứa tên này.
const tieuDeTach = gioiThieu.heroTieuDe.match(/^(.*?)New(techcons)(.*)$/s);
---

<BaseLayout
  tieuDe={gioiThieu.seoTieuDe}
  moTa={gioiThieu.seoMoTa}
>
  <Breadcrumb muc={[{ nhan: 'Trang chủ', href: '/' }, { nhan: 'Giới thiệu' }]} />

  <!-- Hero trang -->
  <section class="relative overflow-hidden bg-navy-deep py-16 sm:py-20">
    <Container class="relative">
      <p class="font-display text-sm font-bold uppercase tracking-widest text-brand-red">{gioiThieu.heroNhan}</p>
      <h1 class="mt-3 max-w-2xl font-display text-2xl font-extrabold leading-[1.2] text-white sm:text-3xl">
        {
          tieuDeTach ? (
            <>
              {tieuDeTach[1]}
              <span class="font-logo uppercase"><span class="text-white">New</span><span class="text-brand-red">{tieuDeTach[2]}</span></span>
              {tieuDeTach[3]}
            </>
          ) : (
            gioiThieu.heroTieuDe
          )
        }
      </h1>
      <p class="mt-5 max-w-2xl text-navy-100">
        {gioiThieu.heroMoTa}
      </p>
      <ul class="mt-5 grid max-w-2xl gap-2.5 sm:grid-cols-2">
        {
          gioiThieu.linhVucHoatDong.map((lv) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-navy-100">
              <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 shrink-0 text-brand-red">
                <path d="M8 12.2 5.3 9.5 4 10.8l4 4 8-8-1.3-1.3z" />
              </svg>
              {lv}
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- Tầm nhìn / Sứ mệnh -->
  <section class="py-16 sm:py-20">
    <Container>
      <div class="mb-10">
        <img
          src={gioiThieu.anh}
          alt={gioiThieu.anhAlt}
          width="1292"
          height="484"
          loading="lazy"
          class="aspect-[16/6] w-full object-cover"
        />
      </div>
      <div class="grid gap-10 sm:grid-cols-2">
        <div class="border-l-4 border-brand-red pl-6">
          <h2 class="font-display text-xl font-bold text-navy-deep">{gioiThieu.tamNhinTieuDe}</h2>
          <p class="mt-3 leading-relaxed text-ink/75">{gioiThieu.tamNhin}</p>
        </div>
        <div class="border-l-4 border-navy pl-6">
          <h2 class="font-display text-xl font-bold text-navy-deep">{gioiThieu.suMenhTieuDe}</h2>
          <p class="mt-3 leading-relaxed text-ink/75">{gioiThieu.suMenh}</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Giá trị cốt lõi -->
  <section class="bg-paper py-16 sm:py-20">
    <Container>
      <SectionHeading canGiua nhan={gioiThieu.giaTriNhan} tieuDe={gioiThieu.giaTriTieuDe} />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          gioiThieu.giaTriCotLoi.map((g, i) => (
            <div class="border border-navy-100 bg-white p-6">
              <span class="font-display text-3xl font-extrabold text-navy-100">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 font-display text-base font-bold text-navy-deep">{g.ten}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{g.mota}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Quy trình làm việc -->
  <section class="bg-navy-deep py-16 sm:py-20">
    <Container>
      <SectionHeading canGiua sang nhan={gioiThieu.quyTrinhNhan} tieuDe={gioiThieu.quyTrinhTieuDe} />
      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
        {
          gioiThieu.quyTrinh.map((b, i) => (
            <li class="relative">
              <div class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-brand-red font-display text-lg font-bold text-white">
                {i + 1}
              </div>
              <h3 class="mt-4 font-display text-sm font-bold uppercase tracking-wide text-white">{b.buoc}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-100">{b.mota}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <LogoStrip />
  <CTASection />
</BaseLayout>
