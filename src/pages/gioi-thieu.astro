---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CTASection from '@/components/CTASection.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { congTy } from '@/data/congTy';
---

<BaseLayout
  tieuDe="Giới thiệu công ty"
  moTa="Tìm hiểu về Newtechcons — năng lực, tầm nhìn, sứ mệnh, giá trị cốt lõi và quy trình làm việc trong lĩnh vực xử lý nước và hệ thống kỹ thuật công nghiệp."
>
  <Breadcrumb muc={[{ nhan: 'Trang chủ', href: '/' }, { nhan: 'Giới thiệu' }]} />

  <!-- Hero trang -->
  <section class="relative overflow-hidden bg-navy-deep py-16 sm:py-20">
    <Container class="relative">
      <p class="font-display text-sm font-bold uppercase tracking-widest text-brand-red">Giới thiệu</p>
      <h1 class="mt-3 max-w-2xl font-display text-3xl font-extrabold text-white sm:text-4xl">
        {congTy.tenDayDu}
      </h1>
      <p class="mt-5 max-w-2xl text-navy-100">
        Chuyên thiết kế, thi công và vận hành hệ thống xử lý nước thải, nước cấp, khí thải và bảo
        trì hệ thống kỹ thuật cho khách hàng công nghiệp trên khắp Việt Nam.
      </p>
    </Container>
  </section>

  <!-- Tầm nhìn / Sứ mệnh -->
  <section class="py-16 sm:py-20">
    <Container>
      <div class="mb-10">
        <img
          src="/images/thuong-hieu/nha-may-xu-ly-tren-cao.jpg"
          alt="Toàn cảnh trên cao một nhà máy xử lý nước thải"
          width="1600"
          height="500"
          loading="lazy"
          class="aspect-[16/6] w-full object-cover"
        />
      </div>
      <div class="grid gap-10 sm:grid-cols-2">
        <div class="border-l-4 border-brand-red pl-6">
          <h2 class="font-display text-xl font-bold text-navy-deep">Tầm nhìn</h2>
          <p class="mt-3 leading-relaxed text-ink/75">{congTy.tamNhin}</p>
        </div>
        <div class="border-l-4 border-navy pl-6">
          <h2 class="font-display text-xl font-bold text-navy-deep">Sứ mệnh</h2>
          <p class="mt-3 leading-relaxed text-ink/75">{congTy.suMenh}</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Giá trị cốt lõi -->
  <section class="bg-paper py-16 sm:py-20">
    <Container>
      <SectionHeading canGiua nhan="Giá trị cốt lõi" tieuDe="Điều làm nên cách chúng tôi làm việc" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          congTy.giaTriCotLoi.map((g, i) => (
            <div class="border border-navy-100 bg-white p-6">
              <span class="font-display text-3xl font-extrabold text-navy-100">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 font-display text-base font-bold text-navy-deep">{g.ten}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{g.mota}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Năng lực / lĩnh vực hoạt động -->
  <section class="py-16 sm:py-20">
    <Container class="grid gap-10 lg:grid-cols-2">
      <div>
        <SectionHeading nhan="Năng lực" tieuDe="Lĩnh vực hoạt động" />
        <ul class="mt-6 space-y-4">
          {
            congTy.linhVucHoatDong.map((lv) => (
              <li class="flex items-start gap-3">
                <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-brand-red">
                  <path d="M8 12.2 5.3 9.5 4 10.8l4 4 8-8-1.3-1.3z" />
                </svg>
                <span class="text-sm leading-relaxed text-ink/80">{lv}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <SectionHeading nhan="Số liệu" tieuDe="Năng lực bằng số liệu cụ thể" />
        <dl class="mt-6 grid grid-cols-2 gap-6">
          {
            congTy.thongKe.map((tk) => (
              <div class="border-l-4 border-navy pl-4">
                <dt class="text-xs uppercase tracking-wide text-ink/50">{tk.nhan}</dt>
                <dd class="mt-1 font-display text-3xl font-extrabold text-navy-deep">{tk.so}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </Container>
  </section>

  <!-- Quy trình làm việc -->
  <section class="bg-navy-deep py-16 sm:py-20">
    <Container>
      <SectionHeading canGiua sang nhan="Quy trình" tieuDe="5 bước triển khai một dự án" />
      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
        {
          congTy.quyTrinh.map((b, i) => (
            <li class="relative">
              <div class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-brand-red font-display text-lg font-bold text-white">
                {i + 1}
              </div>
              <h3 class="mt-4 font-display text-sm font-bold uppercase tracking-wide text-white">{b.buoc}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-100">{b.mota}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <!-- Chứng chỉ -->
  <section class="py-16 sm:py-20">
    <Container>
      <SectionHeading canGiua nhan="Chứng chỉ" tieuDe="Năng lực pháp lý & chứng chỉ hành nghề" />
      <p class="mx-auto mt-4 max-w-xl text-center text-sm text-ink/60">
        <!-- THAY: thay danh sách bên dưới bằng tên chứng chỉ/giấy phép thật, kèm ảnh chụp scan trong thư mục public/images/chung-chi -->
        Danh sách bên dưới là ví dụ minh hoạ — vui lòng thay bằng chứng chỉ, giấy phép hành nghề
        thật của công ty.
      </p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            'Giấy chứng nhận đăng ký doanh nghiệp',
            'Chứng chỉ năng lực hoạt động xây dựng',
            'Chứng chỉ hành nghề tư vấn môi trường',
            'ISO 9001:2015 (nếu có)',
          ].map((tenCC) => (
            <div class="flex flex-col items-center gap-3 border border-dashed border-navy-100 bg-paper p-6 text-center">
              <svg viewBox="0 0 24 24" fill="none" class="h-10 w-10 text-navy-100" stroke="currentColor" stroke-width="1.5">
                <path d="M6 3h8l4 4v14H6V3Z" stroke-linejoin="round" />
                <path d="M14 3v4h4" />
              </svg>
              <p class="text-xs font-semibold text-ink/60">{tenCC}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <LogoStrip />
  <CTASection />
</BaseLayout>
