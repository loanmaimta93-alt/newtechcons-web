---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import CTASection from '@/components/CTASection.astro';
import Button from '@/components/Button.astro';
import { congTy, inDam, trangChu } from '@/data/congTy';

const tatCaDichVu = await getCollection('dich-vu');
const dichVuChinh = tatCaDichVu
  .filter((dv) => trangChu.dichVuChon.includes(dv.id))
  .sort((a, b) => a.data.thuTu - b.data.thuTu);

const tatCaDuAn = await getCollection('du-an');
const duAnNoiBat = tatCaDuAn
  .filter((da) => da.data.noiBat)
  .sort((a, b) => a.data.thuTu - b.data.thuTu)
  .slice(0, 3);
---

<BaseLayout
  tieuDe={trangChu.seoTieuDe}
  moTa={trangChu.seoMoTa}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-deep">
    <div
      class="absolute inset-0 bg-cover bg-center opacity-25"
      style={`background-image:url('${trangChu.heroAnh}')`}
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-deep via-navy-deep/80 to-navy-deep/40" aria-hidden="true"></div>

    <Container class="relative py-16 sm:py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="mb-4 font-display text-sm font-bold uppercase tracking-widest text-brand-red">
          {congTy.phuongCham}
        </p>
        <h1 class="font-times text-4xl font-extrabold leading-[1.1] text-white sm:text-5xl">
          {trangChu.heroTieuDe}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-navy-100">
          {trangChu.heroMoTa}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/lien-he" variant="primary">{trangChu.heroNut1}</Button>
          <Button href="/du-an" variant="ghost">{trangChu.heroNut2}</Button>
        </div>
      </div>
    </Container>
  </section>

  <!-- Giới thiệu ngắn -->
  <section class="py-16 sm:py-20">
    <Container class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div class="relative">
        <img
          src={trangChu.gioiThieuAnh}
          alt={trangChu.gioiThieuAnhAlt}
          width="1200"
          height="720"
          loading="lazy"
          class="aspect-[4/3] w-full object-cover"
        />
        <span class="absolute -bottom-4 -right-4 hidden h-20 w-20 goc-chevron-nguoc bg-brand-red sm:block" aria-hidden="true"></span>
      </div>
      <div>
        <SectionHeading nhan={trangChu.gioiThieuNhan} tieuDe={trangChu.gioiThieuTieuDe} tieuDeClass="font-times" />
        <p class="mt-5 text-base leading-relaxed text-ink/75" set:html={inDam(trangChu.gioiThieuNoiDung)} />
        <ul class="mt-6 space-y-3">
          {
            trangChu.baChuVang.map((c) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 flex h-6 w-11 shrink-0 items-center justify-center bg-navy font-display text-xs font-bold text-white">
                  {c.chu}
                </span>
                <span class="text-sm leading-relaxed text-ink/70">{c.mota}</span>
              </li>
            ))
          }
        </ul>
        <Button href="/gioi-thieu" variant="secondary" class="mt-8 !text-navy border border-navy-100">
          {trangChu.gioiThieuNut}
        </Button>
      </div>
    </Container>
  </section>

  <!-- 3 dịch vụ chính -->
  <section class="bg-paper py-16 sm:py-20">
    <Container>
      <SectionHeading canGiua nhan={trangChu.dichVuNhan} tieuDe={trangChu.dichVuTieuDe} moTa={trangChu.dichVuMoTa} tieuDeClass="font-times" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          dichVuChinh.map((dv) => (
            <ServiceCard href={`/dich-vu/${dv.id}`} icon={dv.data.icon} tieuDe={dv.data.tieuDe} moTa={dv.data.moTaNgan} />
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <Button href="/dich-vu" variant="secondary" class="border border-navy-100 !text-navy">
          {trangChu.dichVuNut}
        </Button>
      </div>
    </Container>
  </section>

  <!-- 3 dự án nổi bật -->
  <section class="py-16 sm:py-20">
    <Container>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading nhan={trangChu.duAnNhan} tieuDe={trangChu.duAnTieuDe} moTa={trangChu.duAnMoTa} tieuDeClass="font-times" />
        <Button href="/du-an" variant="secondary" class="border border-navy-100 !text-navy">
          {trangChu.duAnNut}
        </Button>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          duAnNoiBat.map((da) => (
            <ProjectCard
              href={`/du-an/${da.id}`}
              anh={da.data.anhBia}
              anhAlt={da.data.anhBiaAlt}
              linhVuc={da.data.linhVuc}
              tieuDe={da.data.tieuDe}
              diaDiem={da.data.diaDiem}
              congSuat={da.data.congSuat}
              namHoanThanh={da.data.namHoanThanh}
            />
          ))
        }
      </div>
    </Container>
  </section>

  <LogoStrip />

  <CTASection />
</BaseLayout>
