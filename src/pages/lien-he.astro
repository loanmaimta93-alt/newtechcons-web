---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ContactForm from '@/components/ContactForm.astro';
import { congTy } from '@/data/congTy';

const urlBanDo = `https://www.google.com/maps?q=${encodeURIComponent(congTy.diaChi)}&output=embed`;
---

<BaseLayout
  tieuDe="Liên hệ"
  moTa={`Liên hệ ${congTy.tenNgan} để được khảo sát và tư vấn giải pháp xử lý nước, khí thải cho công trình của bạn. Hotline: ${congTy.hotline}.`}
>
  <Breadcrumb muc={[{ nhan: 'Trang chủ', href: '/' }, { nhan: 'Liên hệ' }]} />

  <section class="bg-navy-deep py-16 sm:py-20">
    <Container>
      <p class="font-display text-sm font-bold uppercase tracking-widest text-brand-red">Liên hệ</p>
      <h1 class="mt-3 max-w-xl font-display text-3xl font-extrabold text-white sm:text-4xl">
        Gửi yêu cầu khảo sát &amp; tư vấn
      </h1>
      <p class="mt-4 max-w-xl text-navy-100">
        Để lại thông tin công trình — đội ngũ kỹ thuật Newtechcons sẽ liên hệ trong 24 giờ làm
        việc, hoặc gọi trực tiếp hotline để được hỗ trợ ngay.
      </p>
    </Container>
  </section>

  <section class="py-16 sm:py-20">
    <Container class="grid gap-12 lg:grid-cols-[1fr_1.3fr]">
      <div class="space-y-8">
        <div>
          <h2 class="font-display text-sm font-bold uppercase tracking-widest text-navy-deep">Thông tin công ty</h2>
          <p class="mt-3 text-lg font-bold text-navy-deep">{congTy.tenDayDu}</p>
          <ul class="mt-4 space-y-3 text-sm text-ink/75">
            <li class="flex items-start gap-3">
              <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-brand-red">
                <path d="M10 2a6 6 0 0 0-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 0 0-6-6Zm0 8.2a2.2 2.2 0 1 1 0-4.4 2.2 2.2 0 0 1 0 4.4Z" />
              </svg>
              <span class="whitespace-pre-line">{congTy.diaChi}</span>
            </li>
            <li class="flex items-start gap-3">
              <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-brand-red">
                <path d="M4 3h3l1.6 4-2 1.2a11 11 0 0 0 5.2 5.2l1.2-2 4 1.6v3a2 2 0 0 1-2 2A14 14 0 0 1 2 6a2 2 0 0 1 2-3Z" />
              </svg>
              <a href={congTy.hotlineHref} class="inline-flex flex-col hover:text-brand-red">
                <span>Hotline:</span>
                <span>{congTy.hotline}</span>
              </a>
            </li>
            <li class="flex items-center gap-3">
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 shrink-0 text-brand-red">
                <path d="M2.5 5.5A2 2 0 0 1 4.5 4h11a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2v-8Zm2-.2 5.5 4 5.5-4" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
              <a href={`mailto:${congTy.email}`} class="break-all hover:text-brand-red">{congTy.email}</a>
            </li>
            <li class="flex items-start gap-3">
              <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-brand-red">
                <path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12Z" />
              </svg>
              <a href={congTy.zaloUrl} target="_blank" rel="noopener noreferrer" class="inline-flex flex-col hover:text-brand-red">
                <span>Chat Zalo:</span>
                <span>{congTy.hotline}</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="border border-navy-100 aspect-[4/3] overflow-hidden">
          <iframe
            src={urlBanDo}
            title={`Bản đồ vị trí ${congTy.tenNgan}`}
            class="h-full w-full"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

      <ContactForm />
    </Container>
  </section>
</BaseLayout>
